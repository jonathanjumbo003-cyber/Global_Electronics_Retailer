-- AOV trend analysis for online stores

WITH order_price AS (
  SELECT
    s.order_number AS order_number,
    s.order_date AS order_date,
    s.store_key AS store_key,
    s.quantity AS quantity,
    p.unit_price_usd AS unit_price_usd,
    s.quantity * p.unit_price_usd AS weighted_price
  FROM global_electronics_retailer.sales AS s
  INNER JOIN global_electronics_retailer.products AS p
    ON s.product_key = p.product_key
  WHERE
    order_date IS NOT NULL
),
year_aov AS (
  SELECT
    EXTRACT(YEAR FROM order_date) AS years,
    ROUND(SAFE_DIVIDE(SUM(weighted_price), COUNT(DISTINCT order_number)), 2) AS yearly_aov
  FROM order_price
  WHERE
    store_key = 0
  GROUP BY
    years
),
year_month_aov AS (
  SELECT
    EXTRACT(YEAR FROM order_date) AS years,
    EXTRACT(MONTH FROM order_date) AS months,
    ROUND(SAFE_DIVIDE(SUM(weighted_price), COUNT(DISTINCT order_number)), 2) AS monthly_aov
  FROM order_price
  WHERE
    store_key = 0
  GROUP BY
    years,
    months
)

SELECT
  ym.years,
  ym.months,
  ym.monthly_aov,
  ya.yearly_aov,
  CASE
    WHEN ym.monthly_aov > ya.yearly_aov THEN 'Higher Than Yearly AOV'
    WHEN ym.monthly_aov < ya.yearly_aov THEN 'Lower Than Yearly AOV'
    ELSE 'Same As Yearly AOV'
  END AS comparison
FROM year_aov AS ya
INNER JOIN year_month_aov AS ym
  ON ya.years = ym.years
WHERE
  ym.years BETWEEN 2016 AND 2020
ORDER BY
  years,
  months;

